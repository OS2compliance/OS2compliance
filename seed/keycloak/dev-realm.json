{
  "realm": "os2compliance",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "administrator",
        "description": "Administrator (all access) -> ROLE_administrator"
      },
      {
        "name": "forandre",
        "description": "Super user (create/update/delete limited parts) -> ROLE_forandre"
      },
      {
        "name": "adgang",
        "description": "Regular user -> ROLE_adgang"
      },
      {
        "name": "begrænset",
        "description": "Limited user -> ROLE_begrænset"
      },
      {
        "name": "læs_kun",
        "description": "Read only user -> ROLE_læs_kun"
      }
    ]
  },
  "clients": [
    {
      "clientId": "https://os2compliance",
      "name": "OS2compliance",
      "enabled": true,
      "protocol": "saml",
      "publicClient": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "https://os2compliance:8343/*"
      ],
      "defaultClientScopes": [
        "saml_organization"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.force.post.binding": "true",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "saml_force_name_id_username": "true",
        "saml_name_id_format": "unspecified",
        "saml.client.signature": "true",
        "saml.allow.ecp.flow": "false",
        "saml_assertion_consumer_url_post": "https://os2compliance:8343/saml/login",
        "saml_single_logout_service_url_post": "https://os2compliance:8343/saml/logout",
        "saml_single_logout_service_url_redirect": "https://os2compliance:8343/saml/logout",
        "saml.signing.certificate": ""
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "saml",
          "protocolMapper": "saml-role-list-mapper",
          "consentRequired": false,
          "config": {
            "single": "false",
            "attribute.name": "roles",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "00000000-0000-4000-8000-000000000001",
      "enabled": true,
      "email": "admin@os2compliance.local",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "realmRoles": [
        "default-roles-os2compliance",
        "administrator"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ]
    }
  ]
}
