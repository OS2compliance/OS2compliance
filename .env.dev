# SAML IdP metadata (Keycloak realm above). Fetched container-to-container;
# the metadata itself advertises http://localhost:8081 URLs for the browser.
SAML_METADATA_LOCATION=url:http://keycloak:8080/realms/os2compliance/protocol/saml/descriptor
# SP entity id — must match the Keycloak client clientId
SAML_ENTITY_ID=https://os2compliance
